{
 "allow": ["calculate", "cancel_pending_order", "exchange_delivered_order_items", "find_user_id_by_email", "find_user_id_by_name_zip",
           "get_item_details", "get_order_details", "get_product_details", "get_user_details", "list_all_product_types",
           "modify_pending_order_address", "modify_pending_order_items", "modify_pending_order_payment", "modify_user_address",
           "return_delivered_order_items", "transfer_to_human_agents"],
 "requires": [
  {"tool": "get_user_details", "after": ["find_user_id_by_email", "find_user_id_by_name_zip"], "success": true},
  {"tool": "modify_user_address", "after": ["find_user_id_by_email", "find_user_id_by_name_zip"], "success": true},
  {"tool": "cancel_pending_order", "after": ["find_user_id_by_email", "find_user_id_by_name_zip"], "success": true},
  {"tool": "modify_pending_order_address", "after": ["find_user_id_by_email", "find_user_id_by_name_zip"], "success": true},
  {"tool": "modify_pending_order_items", "after": ["find_user_id_by_email", "find_user_id_by_name_zip"], "success": true},
  {"tool": "modify_pending_order_payment", "after": ["find_user_id_by_email", "find_user_id_by_name_zip"], "success": true},
  {"tool": "return_delivered_order_items", "after": ["find_user_id_by_email", "find_user_id_by_name_zip"], "success": true},
  {"tool": "exchange_delivered_order_items", "after": ["find_user_id_by_email", "find_user_id_by_name_zip"], "success": true},
  {"tool": "cancel_pending_order", "after": "get_order_details", "same_arg": "order_id", "success": true, "latest": true,
   "result": [{"path": "status", "equals": "pending"}],
   "invalidated_by": ["cancel_pending_order", "modify_pending_order_items", "return_delivered_order_items", "exchange_delivered_order_items"]},
  {"tool": "modify_pending_order_address", "after": "get_order_details", "same_arg": "order_id", "success": true, "latest": true,
   "result": [{"path": "status", "equals": "pending"}],
   "invalidated_by": ["cancel_pending_order", "modify_pending_order_items", "return_delivered_order_items", "exchange_delivered_order_items"]},
  {"tool": "modify_pending_order_items", "after": "get_order_details", "same_arg": "order_id", "success": true, "latest": true,
   "result": [{"path": "status", "equals": "pending"}],
   "invalidated_by": ["cancel_pending_order", "modify_pending_order_items", "return_delivered_order_items", "exchange_delivered_order_items"]},
  {"tool": "modify_pending_order_payment", "after": "get_order_details", "same_arg": "order_id", "success": true, "latest": true,
   "result": [{"path": "status", "equals": "pending"}],
   "invalidated_by": ["cancel_pending_order", "modify_pending_order_items", "return_delivered_order_items", "exchange_delivered_order_items"]},
  {"tool": "return_delivered_order_items", "after": "get_order_details", "same_arg": "order_id", "success": true, "latest": true,
   "result": [{"path": "status", "equals": "delivered"}],
   "invalidated_by": ["cancel_pending_order", "modify_pending_order_items", "return_delivered_order_items", "exchange_delivered_order_items"]},
  {"tool": "exchange_delivered_order_items", "after": "get_order_details", "same_arg": "order_id", "success": true, "latest": true,
   "result": [{"path": "status", "equals": "delivered"}],
   "invalidated_by": ["cancel_pending_order", "modify_pending_order_items", "return_delivered_order_items", "exchange_delivered_order_items"]}
 ],
 "required_args": [
  {"tool": "cancel_pending_order", "args": ["order_id", "reason"]},
  {"tool": "modify_pending_order_address", "args": ["order_id", "address1", "city", "state", "country", "zip"]},
  {"tool": "modify_pending_order_items", "args": ["order_id", "item_ids", "new_item_ids"]},
  {"tool": "modify_pending_order_payment", "args": ["order_id", "payment_method_id"]},
  {"tool": "modify_user_address", "args": ["user_id", "address1", "city", "state", "country", "zip"]},
  {"tool": "return_delivered_order_items", "args": ["order_id", "item_ids", "payment_method_id"]},
  {"tool": "exchange_delivered_order_items", "args": ["order_id", "item_ids", "new_item_ids"]}
 ],
 "max_calls_per_arg": [
  {"tools": ["exchange_delivered_order_items", "modify_pending_order_items"], "arg": "order_id", "max": 1}
 ],
 "values": [
  {"tool": "cancel_pending_order", "arg": "reason", "allowed": ["no longer needed", "ordered by mistake"]}
 ]
}
